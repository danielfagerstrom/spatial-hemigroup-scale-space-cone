@article{ismail1979special,
  title = {Special {Functions}, {Stieltjes} {Transforms} and {Infinite} {Divisibility}},
  volume = {10},
  issn = {0036-1410, 1095-7154},
  url = {http://epubs.siam.org/doi/10.1137/0510083},
  doi = {10.1137/0510083},
  abstract = {We establish the complete monotonicity of several quotients of Whittaker (Tricomi) functions and of parabolic cylinder functions. These results are used to show that the F distribution of any positive degrees of freedom (including fractional) is infinitely divisible and self-decomposable. We also prove the infinite divisibility of several related distributions, including the square of a gamma variable. We also prove that \$x{\textasciicircum}\{\{\{({\textbackslash}nu - {\textbackslash}mu )\} /2\}\} \{\{I\_{\textbackslash}mu ({\textbackslash}sqrt x )\} /\{I\_{\textbackslash}nu ({\textbackslash}sqrt x )\}\}\$ is a completely monotonic function of x when \${\textbackslash}mu {\textgreater} {\textbackslash}nu {\textgreater} - 1\$. This result and the complete monotonicity of \$x{\textasciicircum}\{\{\{({\textbackslash}nu - {\textbackslash}mu )\} /2\}\} \{\{K\_{\textbackslash}nu ({\textbackslash}sqrt x )\} /\{K\_{\textbackslash}mu ({\textbackslash}sqrt x )\}\}\$, \${\textbackslash}mu {\textgreater} {\textbackslash}nu {\textgreater} - 1\$, are used to introduce two new continuous infinitely divisible probability distributions. The limiting cases contain the reciprocal of a gamma distribution and a distribution whose probability density function is a “generalized” theta function. The first distribution is used as a mixing distribution to introduce a new, two paramete...},
  language = {en},
  number = {5},
  urldate = {2026-08-07},
  journal = {SIAM Journal on Mathematical Analysis},
  author = {Ismail, Mourad E. H. and Kelker, Douglas H.},
  month = sep,
  year = {1979},
